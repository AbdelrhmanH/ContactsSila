<?xml version="1.0" encoding="utf-8"?>
<!--
    F-06: قواعد النسخ الاحتياطي (API 26–30 — android:fullBackupContent).

    نفس سياسة الخصوصية في data_extraction_rules.xml: قاعدة بيانات Room المحلية
    (sila_local.db) وملفات WAL/SHM المرافقة وتفضيلات DataStore
    (sila_user_preferences.preferences_pb) تُستثنى من النسخ الاحتياطي السحابي
    (Auto Backup) — بيانات جهات الاتصال لا تغادر الجهاز أبداً (ADR-0009 §6).

    على أندرويد 12+ (API 31+) تُطبَّق data_extraction_rules.xml بدلاً منها.
-->
<full-backup-content>
    <!-- قاعدة بيانات Room المحلية + ملفات WAL/SHM/JOURNAL المرافقة (filesDir الجذر) -->
    <exclude domain="file" path="sila_local.db" />
    <exclude domain="file" path="sila_local.db-wal" />
    <exclude domain="file" path="sila_local.db-shm" />
    <exclude domain="file" path="sila_local.db-journal" />
    <!-- تفضيلات المستخدم (DataStore Preferences) -->
    <exclude domain="file" path="sila_user_preferences.preferences_pb" />
</full-backup-content>
