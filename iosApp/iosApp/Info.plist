<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- F-03: سبب الوصول لجهات الاتصال — إلزامي لطلب CNContactStore.authorization،
	     والطلب يُطلق من تدفق التهيئة الأول حصراً (OnboardingViewModelStore). -->
	<key>NSContactsUsageDescription</key>
	<string>ContactsSila needs access to your contacts to organize them into categories and gently remind you to keep in touch with your family — your data stays on your device only.</string>
	<!-- T6 (Issue #27 · J-3): سبب الوصول للكاميرا — إلزامي لفتح
	     UIImagePickerController(sourceType: .camera) في منتقي صورة
	     جهة الاتصال؛ غيابه يُنهي التطبيق عنذاً عند فتح الكاميرا. -->
	<key>NSCameraUsageDescription</key>
	<string>ContactsSila uses the camera only when you choose to take a profile photo for a contact — the picture is stored with the contact on your device only.</string>
	<!-- T6 (Issue #27): مخططات التطبيقات المتصلة — canOpenURL لكاشف
	     ConnectedAppsDetector (حد أقصى 50 مخططاً؛ القائمة المغلقة نفسها أندرويد). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>tg</string>
		<string>sgnl</string>
		<!-- T8-13 (§L.4 · PLATFORM_PERMISSIONS §7): فحص توفر `tel:` (iPad/بلا شريحة) —
		     دون التصريح يعيد canOpenURL القيمة false دائماً وتُخفى أزرار الطوارئ خطأً. -->
		<string>tel</string>
	</array>
	<!-- T8-13 (D6): مُعرِّف App Group للناشر (Kotlin) — يُوسَّع من APP_GROUP_ID في Config.xcconfig؛
	     إضافة الودجت تقرأ مفتاحها المماثل من Info.plist الخاصة بها. -->
	<key>AppGroupId</key>
	<string>$(APP_GROUP_ID)</string>
</dict>
</plist>
