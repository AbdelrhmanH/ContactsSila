    <!-- Onboarding — Welcome (Issue #26 — T5) -->
    <string name="onboarding_welcome_title_organize">Organize your contacts</string>
    <string name="onboarding_welcome_body_organize">Smart categories for every contact — family, friends, and work — all on your device.</string>
