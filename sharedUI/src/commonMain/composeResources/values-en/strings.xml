    <!-- Onboarding — Contacts permission explainer (permission matrix — Issue #20) -->
    <string name="onboarding_permission_title">Contacts permission</string>
    <string name="onboarding_permission_body">Sila processes your contacts entirely on your device — names, numbers, and call history are never uploaded to any server. The permission is needed only for smart categorization and Arham.</string>
    <string name="onboarding_permission_grant_button">Allow access</string>
    <string name="onboarding_permission_skip_button">Not now</string>
    <string name="onboarding_permission_denied_once_body">Access wasn\'t granted. You can try again, or continue now and finish later from Settings.</string>
    <string name="onboarding_permission_denied_forever_body">The permission is permanently denied in your system. It can only be granted from app settings — we will never ask again.</string>
    <string name="onboarding_permission_open_settings_button">Open app settings</string>
    <string name="onboarding_permission_limited_body">You chose partial access, so only selected contacts appear. You can expand access anytime from the contacts screen.</string>

    <!-- Onboarding — Guest step (Phase 1: no OTP) -->
    <string name="onboarding_guest_title">You\'re ready</string>
