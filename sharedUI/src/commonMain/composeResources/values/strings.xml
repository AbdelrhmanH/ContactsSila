    <string name="onboarding_welcome_title_organize">نظّم جهات اتصالك</string>
    <string name="onboarding_welcome_body_organize">تصنيف ذكي لجميع جهات اتصالك عائلة وأصدقاء وعمل — كل ذلك على جهازك.</string>
