    <!-- التهيئة الأولى — شرح صلاحية جهات الاتصال (مصفوفة الأذونات — Issue #20) -->
    <string name="onboarding_permission_title">صلاحية جهات الاتصال</string>
    <string name="onboarding_permission_body">تعالج صِلَة جهات اتصالك محلياً بالكامل على جهازك — لا ترفع أسماء ولا أرقاماً ولا سجل مكالمات لأي خادم أبداً. تحتاج الصلاحية فقط للتصنيف الذكي ولأرحام.</string>
    <string name="onboarding_permission_grant_button">السماح بالوصول</string>
    <string name="onboarding_permission_skip_button">ليس الآن</string>
    <string name="onboarding_permission_denied_once_body">لم تُمنح الصلاحية. يمكنك إعادة المحاولة، أو المتابعة الآن وإتمامها لاحقاً من الإعدادات.</string>
    <string name="onboarding_permission_denied_forever_body">الصلاحية مرفوضة نهائياً في نظامك. يمكن منحها فقط من إعدادات التطبيق دون إعادة الطلب.</string>
    <string name="onboarding_permission_open_settings_button">فتح إعدادات التطبيق</string>
    <string name="onboarding_permission_limited_body">اخترت عدة جهات فقط. ستظهر المحددَ منها الآن، ويمكن توسيع الوصول من شاشة جهات الاتصال في أي وقت.</string>

    <!-- التهيئة الأولى — خطوة الضيف (المرحلة 1: بدون OTP) -->
    <string name="onboarding_guest_title">أنت جاهز</string>
    <string name="onboarding_guest_body">يمكنك الاستخدام كضيف الآن — كل شيء محلي على جهازك، والتسجيل متاح متى شئت لاحقاً.</string>
    <string name="onboarding_guest_login_note">لا حاجة لحساب في هذه الخطوة؛ التسجيل يُتاح في مرحلة لاحقة من الإعدادات.</string>
    <string name="onboarding_guest_skip_button">متابعة كضيف</string>

    <!-- التهيئة الأولى — أهم 5 أشخاص -->
    <string name="onboarding_top_five_title">أهم 5 أشخاص</string>
    <string name="onboarding_top_five_body">اختر أشخاصاً لا تريد أن تُقطع بهم الصلة. سيصنّفون تلقائياً كـ«عائلة» مع توتّر أسبوعي افتراضي — قابل للتعديل.</string>
    <string name="onboarding_top_five_search_hint">ابحث بالاسم…</string>
    <string name="onboarding_top_five_loading_label">جارٍ تحميل جهات الاتصال…</string>
    <string name="onboarding_top_five_empty_title">دف터ك فارغ</string>
    <string name="onboarding_top_five_empty_body">لا توجد جهات اتصال متاحة للعرض الآن. يمكنك المتابعة دون اختيار.</string>
    <string name="onboarding_top_five_permission_missing_body">لا توجد صلاحية للوصول لجهات الاتصال، لذا لا يمكن بيع «أهم 5 أشخاص» الآن. يمكنك التخطي والمتابعة.</string>
    <string name="onboarding_top_five_limited_body">اخترت الوصول الجزئي، لذا تظهر جهات محددة فقط. الجهات غير المحددة مفقودة بسبب النطاق الجزئي ولن تُحذف أبداً.</string>
