    <string name="onboarding_welcome_title_live">خدمات حية</string>
    <string name="onboarding_welcome_body_live">دليل موثق لأقرب السباكين والصيادلة وأصحاب الخدمات حول ما تحتاج متى احتجتهم.</string>
    <string name="onboarding_welcome_title_arham">أرحام</string>
